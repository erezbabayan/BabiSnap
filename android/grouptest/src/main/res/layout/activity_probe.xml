<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/probe_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/screen_sub"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/header_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <include
            android:id="@+id/countdown_card"
            layout="@layout/card_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            style="@style/Section"
            android:text="1. קיצור דרך של WhatsApp" />

        <Button
            android:id="@+id/add_group"
            style="@style/PrimaryButton"
            android:text="@string/add_group" />

        <TextView
            android:id="@+id/step1_status"
            style="@style/Status" />

        <TextView
            style="@style/Section"
            android:text="2. התראות (גיבוי למזהה)" />

        <Button
            android:id="@+id/notif_settings"
            style="@style/PrimaryButton"
            android:text="@string/notif_settings" />

        <TextView
            android:id="@+id/step2_status"
            style="@style/Status" />

        <TextView
            style="@style/Section"
            android:text="3. נמענים" />

        <Button
            android:id="@+id/open_recipients"
            style="@style/PrimaryButton"
            android:text="@string/open_recipients" />

        <TextView
            android:id="@+id/step3_status"
            style="@style/Status" />

        <TextView
            style="@style/Section"
            android:text="4. שליחת בדיקה" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/message_label"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_bg"
            android:gravity="top|right"
            android:hint="@string/default_text"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:padding="12dp"
            android:text="@string/default_text"
            android:textColor="@color/ink"
            android:textDirection="rtl"
            android:textSize="17sp" />

        <Button
            android:id="@+id/send_test"
            style="@style/PrimaryButton"
            android:text="@string/send_test" />

        <TextView
            android:id="@+id/step4_status"
            style="@style/Status" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mark_ok"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/mark_ok" />

            <Button
                android:id="@+id/mark_bad"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/mark_bad" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="5. נגישות" />

        <Button
            android:id="@+id/a11y_settings"
            style="@style/PrimaryButton"
            android:text="@string/a11y_settings" />

        <TextView
            android:id="@+id/step5_status"
            style="@style/Status" />

        <Switch
            android:id="@+id/auto_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/auto_switch"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/auto_hint"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            style="@style/Section"
            android:text="6. דוח" />

        <Button
            android:id="@+id/copy_report"
            style="@style/PrimaryButton"
            android:text="@string/copy_report" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="הדוח הוא קודים בלבד: בלי שמות, בלי מספרים, בלי מזהים ובלי טקסט ההודעה."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/restricted_help"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
