<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipients_title"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/recipients_help"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/perm_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <Button
        android:id="@+id/perm_button"
        style="@style/GhostButton"
        android:text="אפשר אנשי קשר"
        android:visibility="gone" />

    <Button
        android:id="@+id/pick_contact"
        style="@style/PrimaryButton"
        android:text="@string/pick_contact" />

    <Button
        android:id="@+id/add_number"
        style="@style/GhostButton"
        android:text="@string/add_number" />

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_bg"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textDirection="rtl"
        android:textSize="17sp" />

    <Button
        android:id="@+id/select_all"
        style="@style/PrimaryButton"
        android:text="@string/select_all" />

    <TextView
        android:id="@+id/list_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />
</LinearLayout>
