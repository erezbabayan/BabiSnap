<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ProbeTheme" parent="android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Status">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="GhostButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
