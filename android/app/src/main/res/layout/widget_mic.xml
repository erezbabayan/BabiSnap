<?xml version="1.0" encoding="utf-8"?>
<!-- Large tap-to-speak widget (approved sample E): B logo with a mic badge, and the 5 destinations.
     Wide: icon + label. Medium: icons only. Narrow: logo and name only. Chosen in MicWidget by width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr"
    android:background="@drawable/widget_bg" android:paddingStart="8dp" android:paddingEnd="10dp"
    android:contentDescription="@string/widget_hint">
    <ImageView android:id="@+id/mic" android:layout_width="52dp" android:layout_height="52dp"
        android:src="@drawable/widget_logo_mic" android:contentDescription="@string/widget_desc" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="#2A1B7A" android:textSize="16sp"
            android:textStyle="bold" android:maxLines="1" android:textDirection="ltr" />
        <LinearLayout android:id="@+id/dest_labels" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layoutDirection="rtl" android:layout_marginTop="2dp" android:visibility="gone">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center_horizontal" android:layout_marginEnd="6dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_dest_calendar" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="יומן"
                    android:textColor="#2A1B7A" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center_horizontal" android:layout_marginEnd="6dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_dest_whatsapp" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="וואטסאפ"
                    android:textColor="#2A1B7A" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center_horizontal" android:layout_marginEnd="6dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_dest_call" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="שיחה"
                    android:textColor="#2A1B7A" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center_horizontal" android:layout_marginEnd="6dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_dest_task" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="משימה"
                    android:textColor="#2A1B7A" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center_horizontal" android:layout_marginEnd="6dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_dest_note" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="הערה"
                    android:textColor="#2A1B7A" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/dest_icons" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layoutDirection="rtl" android:layout_marginTop="3dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_dest_calendar" android:importantForAccessibility="no" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_dest_whatsapp" android:importantForAccessibility="no" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_dest_call" android:importantForAccessibility="no" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_dest_task" android:importantForAccessibility="no" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_dest_note" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
