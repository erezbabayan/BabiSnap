<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:padding="24dp" android:background="@drawable/listen_bg"
    android:layoutDirection="rtl">
    <FrameLayout android:layout_width="160dp" android:layout_height="160dp">
        <View android:id="@+id/halo" android:layout_width="120dp" android:layout_height="120dp"
            android:layout_gravity="center" android:background="@drawable/listen_halo" />
        <ImageView android:id="@+id/logo" android:layout_width="96dp" android:layout_height="96dp"
            android:layout_gravity="center" android:src="@drawable/widget_logo"
            android:contentDescription="@string/app_name" />
    </FrameLayout>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="מקשיב… מה לקבוע ביומן?" android:textColor="#2A1B7A"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/partial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:minHeight="40dp" android:textColor="#7A5A10"
        android:textSize="15sp" />
    <TextView android:id="@+id/cancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:padding="8dp" android:text="ביטול" android:textColor="#6A5FA8"
        android:textSize="15sp" />
</LinearLayout>
