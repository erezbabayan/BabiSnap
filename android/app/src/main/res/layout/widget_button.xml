<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- Same size as app icons (82% of the cell width, set in ButtonWidget; 76dp fallback), top aligned with icons (3dp offset). -->
    <ImageView android:id="@+id/mic" android:layout_width="76dp" android:layout_height="76dp" android:layout_marginTop="3dp"
        android:layout_gravity="top|center_horizontal" android:padding="0dp" android:src="@drawable/record_tile"
        android:scaleType="fitCenter" android:adjustViewBounds="true"
        android:contentDescription="@string/widget_button_desc" />
</FrameLayout>
