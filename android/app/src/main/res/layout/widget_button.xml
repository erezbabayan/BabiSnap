<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- Top-aligned and app-icon sized (54dp, shrunk to the cell's min dimension in ButtonWidget), no padding. -->
    <ImageView android:id="@+id/mic" android:layout_width="54dp" android:layout_height="54dp"
        android:layout_gravity="top|center_horizontal" android:padding="0dp" android:src="@drawable/record_tile"
        android:scaleType="fitCenter" android:adjustViewBounds="true"
        android:contentDescription="@string/widget_button_desc" />
</FrameLayout>
