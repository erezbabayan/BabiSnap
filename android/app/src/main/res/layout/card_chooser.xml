<?xml version="1.0" encoding="utf-8"?>
<!-- «לאן לשלוח?» route chooser (sample F). Circles are added in VoiceActivity from RouteChooser.choices(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:padding="22dp" android:background="@drawable/listen_bg"
    android:layoutDirection="rtl">
    <TextView android:id="@+id/headline" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#2A1B7A" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/summary_bg" android:gravity="start"
        android:lineSpacingMultiplier="1.3" android:padding="12dp" android:textColor="#2A1B7A" android:textSize="14sp" />
    <LinearLayout android:id="@+id/choices" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="vertical" />
    <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="start" android:textColor="#6A5FA8" android:textSize="12sp" />
    <ProgressBar android:id="@+id/countdown" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="6dp"
        android:max="8000" android:progress="8000" android:progressTint="#8E3BD9" android:progressBackgroundTint="#EADFB5" />
    <TextView android:id="@+id/cancel" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:padding="8dp" android:text="ביטול" android:textColor="#6A5FA8" android:textSize="14sp" />
</LinearLayout>
