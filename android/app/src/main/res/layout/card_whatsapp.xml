<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:padding="24dp" android:background="@drawable/listen_bg"
    android:layoutDirection="rtl">
    <TextView android:id="@+id/check" android:layout_width="72dp" android:layout_height="72dp"
        android:background="@drawable/saved_circle" android:gravity="center" android:text="💬"
        android:textColor="#075E54" android:textSize="34sp" />
    <TextView android:id="@+id/headline" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center" android:text="לשלוח לוואטסאפ?"
        android:textColor="#2A1B7A" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/chip_whatsapp" android:paddingStart="10dp"
        android:paddingEnd="10dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="וואטסאפ"
        android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/summary_bg" android:gravity="start"
        android:lineSpacingMultiplier="1.3" android:padding="12dp" android:textColor="#2A1B7A" android:textSize="14sp" />
    <TextView android:id="@+id/wa_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:textColor="#6A5FA8" android:textSize="12sp"
        android:text="אפשר לשלוח עכשיו. בלי בחירה ההודעה מתבטלת ונמחקת." />
    <ProgressBar android:id="@+id/countdown" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="14dp"
        android:max="8000" android:progress="8000" android:progressTint="#075E54" android:progressBackgroundTint="#EADFB5" />
    <TextView android:id="@+id/send_voice" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:padding="8dp" android:text="שלח הקלטה" android:textColor="#075E54" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/send_text" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:text="שלח תמלול" android:textColor="#2A1B7A" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/cancel_wa" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:padding="8dp" android:text="ביטול" android:textColor="#6A5FA8" android:textSize="14sp" />
</LinearLayout>
