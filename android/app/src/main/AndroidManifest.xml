<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Invites, WhatsApp name lookup, and an immediate voice call. On-device only. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Places the call the user asked for, only after «אישור לבצע שיחות» and the visible countdown. No call log. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Requested only when the user connects יומן המכשיר. Local Calendar Provider read/write; no Microsoft Graph. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>
    <!-- See the installed WhatsApp app for a share Intent. Not a permission, and not the Business API. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>
    <!-- wa.me opens the private chat when the jid share does not. Not a permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="wa.me" />
        </intent>
    </queries>
    <!-- Dialer, and a direct call when the settings switch and CALL_PHONE are both on. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
    </queries>
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true" android:theme="@android:style/Theme.DeviceDefault.Light.DarkActionBar">
        <!-- First LAUNCHER activity. Samsung side-key Open app starts getLaunchIntentForPackage, which takes this one. -->
        <activity android:name=".RecordEntryActivity" android:exported="true"
            android:label="@string/record_entry_label" android:icon="@drawable/record_tile"
            android:roundIcon="@drawable/record_tile"
            android:excludeFromRecents="true" android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Exported only for the babisnap://pair deep link; it accepts nothing but a validated BabiTk token for the fixed endpoint. -->
        <activity android:name=".BabiTkSettingsActivity" android:exported="true" android:label="חיבור BabiTk" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${pairScheme}" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- Opened only from our own widgets (explicit PendingIntent) and MainActivity: not exported. -->
        <activity android:name=".VoiceActivity" android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="com.babisnap.app.voice" android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar" />
        <service android:name=".BabiSnapVoiceService" android:exported="true"
            android:label="@string/app_name" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction_service" />
        </service>
        <service android:name=".BabiSnapSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- Stub only, so the assistant entry is valid. It does not open the microphone. -->
        <service android:name=".BabiSnapRecognition" android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/recognition_service" />
        </service>
        <receiver android:name=".MicWidget" android:exported="false" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mic_widget" />
        </receiver>
        <receiver android:name=".ButtonWidget" android:exported="false" android:label="@string/widget_button_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/button_widget" />
        </receiver>
        <!-- Voice file for a WhatsApp share. Cache only, not exported. -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.wa"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/wa_file_paths" />
        </provider>
    </application>
</manifest>
